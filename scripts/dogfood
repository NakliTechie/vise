#!/bin/sh
# Build a vise-gated clone of this checkout, ready to hand to a coding agent.
#
# Every round of testing vise against real agents began by rebuilding this
# target by hand, and every rebuild rediscovered the same half-dozen details:
# vendor the dependencies so no probe needs the network, put the build cache
# inside the checkout and ignore it, name the toolchain so nothing downloads,
# keep the probe quiet on success, commit the baseline so a fresh clone can
# gate. Getting one wrong costs an hour of diagnosing the agent's sandbox.
#
# Usage: scripts/dogfood [target-directory]
set -eu

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
VISE_ROOT=$(CDPATH='' cd -- "$SCRIPT_DIR/.." && pwd)
TOOLCHAIN=go$(awk '$1 == "go" { print $2; exit }' "$VISE_ROOT/go.mod")
TARGET=${1:-${TMPDIR:-/tmp}/vise-dogfood}

step() { printf 'dogfood: %s\n' "$1"; }
die() { printf 'dogfood: %s\n' "$1" >&2; exit 1; }

[ -e "$TARGET" ] && die "$TARGET already exists; remove it or name another directory"

step "building vise from $VISE_ROOT"
BIN=$TARGET.bin
mkdir -p "$BIN"
( cd -- "$VISE_ROOT" && GOTOOLCHAIN=$TOOLCHAIN go build -o "$BIN/vise" ./cmd/vise ) \
  || die "cannot build vise from this checkout"

step "cloning into $TARGET"
git clone -q -- "$VISE_ROOT" "$TARGET" || die "clone failed"
cd -- "$TARGET" || die "cannot enter $TARGET"

# Drop any baseline the checkout carries. This script records its own, and an
# inherited vise.lock makes record refuse with operator-review — so the script
# stopped working the moment it was run from inside a target it had built,
# which is the most obvious thing to try.
rm -rf .vise vise.lock
git rm -r -q --cached --ignore-unmatch .vise vise.lock >/dev/null 2>&1 || true
git -c user.email=dogfood@vise.invalid -c user.name=dogfood \
    commit -qm "Drop the inherited baseline" >/dev/null 2>&1 || true

step "vendoring dependencies (an agent sandbox has no network)"
GOTOOLCHAIN=$TOOLCHAIN GOFLAGS='' go mod vendor >/dev/null 2>&1 \
  || die "go mod vendor failed"

step "writing the probe wrapper and manifest"
cat > probe-cli.sh <<'PROBE'
#!/bin/sh
# Build this checkout quietly and run it with the given arguments.
#
# Quiet on success, loud on failure: a probe must judge the output it means to
# freeze, not incidental noise from the toolchain. Inside an agent sandbox the
# Go build emits permission warnings it never emits in a terminal, and a probe
# that freezes those is stable for its author and flaky for everyone else.
#
# Everything stays inside the workspace: vendored modules (no network), a build
# cache under the checkout (no writes outside it), a named toolchain (no
# download). An agent sandbox denies all three.
set -eu
BIN="$VISE_TMP/vise"
if ! GOCACHE="$PWD/.gocache" GOFLAGS=-mod=vendor GOTOOLCHAIN=TOOLCHAIN_PLACEHOLDER \
     go build -o "$BIN" ./cmd/vise 2>"$VISE_TMP/build.err"; then
  # Print only the compiler's own diagnostics. A build failure is deterministic
  # — the code either compiles or it does not — but the toolchain's other
  # chatter is not: sandbox permission warnings, cache notices, and download
  # lines vary between callers and between runs. Letting those into the
  # observation makes two passes of the same broken code disagree, and vise
  # reports that as a flake. The agent contract says stop and report on a
  # flake, so a plain compile error would end the session instead of telling
  # the agent to fix the code it just wrote.
  grep -E '(^#|\.go:)' "$VISE_TMP/build.err" >&2 || cat "$VISE_TMP/build.err" >&2
  exit 1
fi
exec "$BIN" "$@"
PROBE
sed "s/TOOLCHAIN_PLACEHOLDER/$TOOLCHAIN/" probe-cli.sh > probe-cli.sh.tmp
mv probe-cli.sh.tmp probe-cli.sh
chmod +x probe-cli.sh

cat > vise.toml <<MANIFEST
[vise]
version = 1

[stubs]
tz = "UTC"
lang = "C"
seed = "1729"
network = "declared-off"

# Fingerprint the toolchain the probes pin, not whatever is first on PATH.
[env]
fingerprint = ["GOTOOLCHAIN=$TOOLCHAIN go version"]

[[probe]]
id = "cli-help"
run = "./probe-cli.sh --help"
timeout = 300
deps = ["probe-cli.sh"]

[[probe]]
id = "cli-version"
run = "./probe-cli.sh version"
timeout = 300
deps = ["probe-cli.sh"]

# The review diff is the output whose whole job is to be read carefully, and
# until a coding agent said so out loud, nothing gated it: it refactored the
# renderer, the gate went green, and no declared probe had walked the code. A
# preview against a manifest that keeps one probe with different output, drops
# another, and adds a third exercises the changed, removed, and added branches
# in one deterministic render.
[[probe]]
id = "cli-review-diff"
run = "./probe-preview.sh"
timeout = 300
deps = ["probe-preview.sh", "probe-cli.sh"]

# The perception act an agent performs first, every session. Rendered against a
# throwaway repository because status reports the live journal, which changes
# with every run here.
[[probe]]
id = "cli-status"
run = "./probe-status.sh"
timeout = 300
deps = ["probe-status.sh"]

# An error path is observable behavior too, and the one most likely to be
# quietly reworded by a refactor. The trailing branch keeps the probe's own
# exit at 0; what is frozen is the message and the exit code vise printed.
# The \$ is escaped because this heredoc is unquoted: an unescaped $? was
# expanded when the manifest was generated, so the probe froze a literal 0 and
# observed no exit code at all. Found by a cold audit, not by the gate, which
# was green the whole time.
[[probe]]
id = "cli-unknown-command"
run = "./probe-cli.sh no-such-command 2>&1 || printf 'exit=%s\\n' \$?"
timeout = 300
deps = ["probe-cli.sh"]
MANIFEST

# The build cache line is load-bearing, not housekeeping: vise compares the
# whole work tree around every judged run, so an unignored cache is a stray a
# probe wrote, and every gate would be a harness error.
cat >> .gitignore <<'IGNORE'
.vise/journal.jsonl
.vise/run.lock
.vise/tmp/
.gocache/
IGNORE

cat > probe-preview.sh <<'PREVIEW'
#!/bin/sh
# Render a review diff deterministically.
#
# Builds a throwaway repository under $VISE_TMP, records it, then previews a
# manifest in which one probe keeps its id and changes its output, one is
# removed, and one is added — so the changed, removed, and added branches of
# the renderer all appear in one frozen output. Digests vary with the tree, so
# the sha256 values are normalised away; what is frozen is the shape of the
# render.
set -eu
BIN="$VISE_TMP/vise"
GOCACHE="$PWD/.gocache" GOFLAGS=-mod=vendor GOTOOLCHAIN=TOOLCHAIN_PLACEHOLDER \
  go build -o "$BIN" ./cmd/vise 2>"$VISE_TMP/preview-build.err" || {
    grep -E '(^#|\.go:)' "$VISE_TMP/preview-build.err" >&2 || cat "$VISE_TMP/preview-build.err" >&2
    exit 1
  }

WORK="$VISE_TMP/preview"
mkdir -p "$WORK"
cd "$WORK"
git init -q .
git config user.email preview@vise.invalid
git config user.name preview
printf '.vise/journal.jsonl\n.vise/run.lock\n.vise/tmp/\n' > .gitignore
printf '[vise]\nversion = 1\n[[probe]]\nid = "kept"\nrun = "printf one"\n[[probe]]\nid = "removed"\nrun = "printf gone"\n' > vise.toml
git add -A
git commit -qm base
"$BIN" record > /dev/null
# "kept" survives with different output, "removed" goes, "added" arrives: all
# three branches of the renderer in one frozen render. An earlier version
# swapped one id for another, so nothing was ever "changed" and the comment
# above claiming that branch was covered was simply wrong — found by an agent
# auditing this probe's own coverage claim.
printf '[vise]\nversion = 1\n[[probe]]\nid = "kept"\nrun = "printf one-changed"\n[[probe]]\nid = "added"\nrun = "printf two"\n' > vise.toml
# Commit the new manifest before previewing. record refuses a dirty tree, and
# the first version of this probe froze that refusal instead of a review diff —
# a probe that looked like coverage, passed, and walked none of the code it was
# written to watch.
git add -A
git commit -qm change
"$BIN" record --preview 2>&1 | sed -E 's/[0-9a-f]{64}/HASH/g; s/[0-9a-f]{40}/COMMIT/g'
PREVIEW
sed "s/TOOLCHAIN_PLACEHOLDER/$TOOLCHAIN/" probe-preview.sh > probe-preview.sh.tmp
mv probe-preview.sh.tmp probe-preview.sh
chmod +x probe-preview.sh

cat > probe-status.sh <<'STATUS'
#!/bin/sh
# Render the perception act deterministically.
#
# status reports the live journal, so it is rendered against a throwaway
# repository with exactly one recorded probe and one gate behind it. Hashes and
# commit names are normalised; what is frozen is every line status prints and
# the order it prints them in — the one screen an agent reads before it does
# anything else.
set -eu
BIN="$VISE_TMP/vise"
GOCACHE="$PWD/.gocache" GOFLAGS=-mod=vendor GOTOOLCHAIN=TOOLCHAIN_PLACEHOLDER \
  go build -o "$BIN" ./cmd/vise 2>"$VISE_TMP/status-build.err" || {
    grep -E '(^#|\.go:)' "$VISE_TMP/status-build.err" >&2 || cat "$VISE_TMP/status-build.err" >&2
    exit 1
  }

WORK="$VISE_TMP/statusrepo"
mkdir -p "$WORK"
cd "$WORK"
git init -q .
git config user.email status@vise.invalid
git config user.name status
printf '.vise/journal.jsonl\n.vise/run.lock\n.vise/tmp/\n' > .gitignore
printf '[vise]\nversion = 1\n[[probe]]\nid = "only"\nrun = "printf one"\n' > vise.toml
git add -A
git commit -qm base
"$BIN" record > /dev/null
"$BIN" gate --quiet > /dev/null
"$BIN" status 2>&1 | sed -E 's/[0-9a-f]{64}/HASH/g; s/[0-9a-f]{40}/COMMIT/g'
STATUS
sed "s/TOOLCHAIN_PLACEHOLDER/$TOOLCHAIN/" probe-status.sh > probe-status.sh.tmp
mv probe-status.sh.tmp probe-status.sh
chmod +x probe-status.sh

step "committing the harness"
git add -A >/dev/null
git -c user.email=dogfood@vise.invalid -c user.name=dogfood \
    commit -qm "Vendor dependencies and add agent-ready probes" >/dev/null

step "recording the baseline (two full passes)"
"$BIN/vise" record >/dev/null || die "record failed; run '$BIN/vise record' in $TARGET to see why"
git add -A >/dev/null
git -c user.email=dogfood@vise.invalid -c user.name=dogfood \
    commit -qm "Record behavior baseline" >/dev/null

step "checking the repository is fit to hand to an agent"
"$BIN/vise" doctor

step "cold gate — nothing inherited from this shell"
env -i HOME="$HOME" PATH="$(dirname -- "$(command -v go)"):/usr/bin:/bin" \
    "$BIN/vise" gate --quiet \
  || die "the cold gate is not green; an agent would inherit this failure"

printf '\n'
step "ready: $TARGET"
step "vise binary: $BIN/vise"
step "hand it to an agent with the task, and AGENTS.md is already at its root"
