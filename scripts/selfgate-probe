#!/bin/sh
# Operator-owned observations for the root baseline. Each invocation builds the
# current work tree; the installed vise judging it is a separate, fixed binary.
set -eu

: "${VISE_TMP:?run this wrapper through vise}"
SELF_ROOT=$(pwd)
SELF_BIN="$VISE_TMP/vise-under-test"
export GOCACHE="$SELF_ROOT/.gocache"
export GOENV=off GOWORK=off GOFLAGS=-mod=vendor GOPROXY=off
export GOTOOLCHAIN=go1.25.13 CGO_ENABLED=0

# Build identity is tested by scripts/verify. Omitting VCS stamps only in the
# subject binary keeps commits and dirty-state changes out of these observations.
if ! go build -trimpath -buildvcs=false -o "$SELF_BIN" ./cmd/vise 2>"$VISE_TMP/build.err"; then
    cat "$VISE_TMP/build.err" >&2
    exit 1
fi

# Do not inherit signing, hooks, templates, identity, or wall-clock commit dates.
# Fixed fixture inputs make commit and lock hashes reproducible without masking
# any part of the program's output. The outer baseline still fingerprints the
# actual platform and toolchain.
export GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null
export GIT_AUTHOR_NAME=selfgate GIT_COMMITTER_NAME=selfgate
export GIT_AUTHOR_EMAIL=selfgate@vise.invalid GIT_COMMITTER_EMAIL=selfgate@vise.invalid
export GIT_AUTHOR_DATE='2000-01-01T00:00:00Z' GIT_COMMITTER_DATE='2000-01-01T00:00:00Z'

fixture() {
    mkdir -p "$VISE_TMP/fixture" "$VISE_TMP/empty-template"
    cd "$VISE_TMP/fixture"
    git init -q --initial-branch=main --object-format=sha1 --template="$VISE_TMP/empty-template"
    git config core.autocrlf false
    git config commit.gpgsign false
    printf '.vise/journal.jsonl\n.vise/run.lock\n.vise/tmp/\n' > .gitignore
    printf 'Disposable self-gate fixture.\n' > AGENTS.md
}

commit_fixture() {
    git add -A
    git commit -qm "$1"
}

# Record the real exit beside the complete stdout/stderr, and reject an
# unexpected exit even during initial recording. Never pipe vise into a command
# that could conceal its failure.
observe() {
    expected_exit=$1
    shift
    printf '$ vise'
    for arg do printf ' %s' "$arg"; done
    printf '\n'
    actual_exit=0
    "$SELF_BIN" "$@" || actual_exit=$?
    printf 'exit=%s\n' "$actual_exit"
    test "$actual_exit" -eq "$expected_exit"
}

case "${1:-}" in
    help) exec "$SELF_BIN" --help ;;
    version) exec "$SELF_BIN" version ;;
    invalid-command)
        # Use a fixture so this command never needs the parent's held run lock,
        # even if a future dispatch regression tries to acquire one.
        fixture
        observe 2 no-such-command
        observe 2 no-such-command --json
        ;;
    status|doctor)
        fixture
        cat > vise.toml <<'MANIFEST'
[vise]
version = 1
[env]
fingerprint = ["git --version"]
[[probe]]
id = "only"
run = "printf one"
MANIFEST
        commit_fixture base
        "$SELF_BIN" record > /dev/null
        commit_fixture baseline
        "$SELF_BIN" gate --quiet > /dev/null
        observe 0 "$1"
        ;;
    review)
        fixture
        cat > vise.toml <<'MANIFEST'
[vise]
version = 1
[[probe]]
id = "kept"
run = "printf one"
[[probe]]
id = "removed"
run = "printf gone"
MANIFEST
        commit_fixture base
        "$SELF_BIN" record > /dev/null
        cat > vise.toml <<'MANIFEST'
[vise]
version = 1
[[probe]]
id = "kept"
run = "printf one-changed"
[[probe]]
id = "added"
run = "printf two"
MANIFEST
        commit_fixture change
        observe 0 record --preview
        ;;
    pin)
        fixture
        mkdir spec
        printf 'hello Ada\n' > spec/greet.stdout
        cat > vise.toml <<'MANIFEST'
[vise]
version = 1
[[probe]]
id = "greet"
run = "./greet.sh"
expect.stdout = "spec/greet.stdout"
MANIFEST
        commit_fixture spec-first
        observe 0 record
        observe 6 gate --json
        observe 0 status
        printf '#!/bin/sh\nprintf "hello Ada\\n"\n' > greet.sh
        chmod +x greet.sh
        commit_fixture build
        observe 0 gate --json
        observe 0 record --preview
        # This operator-shaped command acts only on the disposable fixture.
        # The root's acceptance remains an explicit operator action.
        observe 0 record --i-reviewed-the-diff
        commit_fixture accepted
        observe 0 gate --json
        observe 0 status
        printf 'changed spec\n' > spec/greet.stdout
        observe 2 gate --json
        ;;
    exit-only)
        fixture
        cat > vise.toml <<'MANIFEST'
[vise]
version = 1
[[probe]]
id = "zero"
run = "sh program.sh 0"
expect.exit = 0
[[probe]]
id = "nonzero"
run = "sh program.sh 42"
expect.exit = 42
[[probe]]
id = "maximum"
run = "sh program.sh 255"
expect.exit = 255
MANIFEST
        cat > program.sh <<'PROGRAM'
printf unexpected
exit "$1"
PROGRAM
        commit_fixture exit-only-spec
        observe 0 record
        observe 6 gate --json
        cat > program.sh <<'PROGRAM'
exit "$1"
PROGRAM
        commit_fixture meet-exit-only-spec
        observe 0 gate --json
        observe 0 record --preview
        observe 0 record --i-reviewed-the-diff
        commit_fixture accept-exit-only-spec
        observe 0 gate --json
        cp vise.lock "$VISE_TMP/accepted.lock"
        observe 0 record --i-reviewed-the-diff
        cmp vise.lock "$VISE_TMP/accepted.lock"
        printf 'repeat acceptance preserved lock bytes\n'
        cat > program.sh <<'PROGRAM'
printf unexpected >&2
exit "$1"
PROGRAM
        observe 1 gate --json
        ;;
    unknown-probe)
        fixture
        cat > vise.toml <<'MANIFEST'
[vise]
version = 1
[[probe]]
id = "known"
run = "printf known"
MANIFEST
        commit_fixture known-probe
        for command in gate verify; do
            observe 2 "$command" --probe unknown --json
        done
        test ! -e .vise/journal.jsonl
        printf 'unknown selection without baseline wrote no journal\n'
        observe 4 gate --probe known --json
        observe 0 record
        commit_fixture recorded-known-probe
        cp .vise/journal.jsonl "$VISE_TMP/before.journal"
        for command in gate verify; do
            observe 2 "$command" --probe unknown --json
        done
        cmp .vise/journal.jsonl "$VISE_TMP/before.journal"
        printf 'unknown selection preserved journal bytes\n'
        observe 0 gate --probe known --json
        ;;
    spec-dependency)
        fixture
        printf '.calls\n' >> .gitignore
        mkdir spec fixtures
        printf 'hello\n' > spec/shared
        printf 'hello\n' > spec/other
        printf 'input\n' > fixtures/input
        cat > vise.toml <<'MANIFEST'
[vise]
version = 1
[[probe]]
id = "pin"
run = "printf ran >> .calls; cat fixtures/input > /dev/null; cat spec/shared"
deps = ["spec/shared", "fixtures/input"]
expect.stdout = "spec/shared"
MANIFEST
        commit_fixture shared-spec-and-dependency
        observe 0 record
        commit_fixture recorded-shared-role
        observe 0 gate --json
        rm .calls
        printf 'changed\n' > spec/shared
        observe 2 gate --json
        observe 0 status
        test ! -e .calls
        rm spec/shared
        observe 2 gate --json
        observe 0 status
        test ! -e .calls
        ln -s other spec/shared
        observe 2 gate --json
        observe 0 status
        test ! -e .calls
        rm spec/shared
        printf 'hello\n' > spec/shared
        printf 'changed\n' > fixtures/input
        observe 2 gate --json
        observe 0 status
        test ! -e .calls
        printf 'all four preflight failures prevented probe execution\n'
        ;;
    pipe-holder)
        fixture
        printf '.mode\n' >> .gitignore
        mkdir spec
        printf 'wanted\n' > spec/out
        cat > vise.toml <<'MANIFEST'
[vise]
version = 1
[[probe]]
id = "holder-short"
run = "if test -f .mode; then sleep 20 & printf ran; exit 127; else exit 127; fi"
timeout = 1
expect.stdout = "spec/out"
[[probe]]
id = "holder-long"
run = "if test -f .mode; then sleep 20 & printf ran; exit 42; else exit 127; fi"
timeout = 5
expect.stdout = "spec/out"
[[probe]]
id = "live-timeout"
run = "if test -f .mode; then sleep 20 & wait; else exit 127; fi"
timeout = 1
expect.stdout = "spec/out"
MANIFEST
        commit_fixture pipe-and-timeout-spec
        observe 0 record
        commit_fixture recorded-pipe-and-timeout-spec
        printf 'run\n' > .mode
        observe 2 gate --probe holder-short --json
        observe 2 gate --probe holder-long --json
        observe 6 gate --probe live-timeout --json
        ;;
    exit127)
        fixture
        mkdir spec
        printf 'wanted\n' > spec/out
        printf '#!/bin/sh\nprintf ran\nexit 127\n' > program.sh
        chmod +x program.sh
        cat > vise.toml <<'MANIFEST'
[vise]
version = 1
[[probe]]
id = "executed-direct"
run = "./program.sh"
expect.stdout = "spec/out"
[[probe]]
id = "executed-shell"
run = "sh program.sh"
expect.stdout = "spec/out"
[[probe]]
id = "missing-program"
run = "./does-not-exist"
expect.stdout = "spec/out"
MANIFEST
        commit_fixture exit127-spec
        observe 0 record
        commit_fixture recorded-exit127-spec
        observe 6 gate --json
        observe 127 run executed-direct
        observe 127 run executed-shell
        ;;
    *) printf 'unknown self-gate scenario: %s\n' "${1:-}" >&2; exit 2 ;;
esac
